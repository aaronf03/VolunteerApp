<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ── Base Text Styles ─────────────────────────────────────────── -->
    <style name="Text" />

    <style name="Text.Label" />

    <!-- ── Display / headline text (Fraunces stand-in) ─────────────────── -->

    <style name="Text.Display">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/charcoal</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Display.Hero">
        <item name="android:textSize">30sp</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="Text.Display.H2">
        <item name="android:textSize">24sp</item>
    </style>

    <style name="Text.Display.H3">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Text.Display.CardTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- ── Body text (Nunito stand-in) ──────────────────────────────────── -->
    <style name="Text.Body">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text.Body.Muted">
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="Text.Label.Uppercase">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- ── Inputs ────────────────────────────────────────────────────────── -->
    <style name="Widget.VolunteerApp.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/forest</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="hintEnabled">false</item>
    </style>

    <!-- ── Buttons ───────────────────────────────────────────────────────── -->
    <style name="Widget.VolunteerApp.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/forest</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
    </style>

    <style name="Widget.VolunteerApp.Button.Small" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/forest</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <style name="Widget.VolunteerApp.Chip.Tab" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">100dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

</resources>
